{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wporg/contributor-orientation",
	"version": "0.2.0",
	"title": "Contributor Orientation Block",
	"category": "widgets",
	"icon": "community",
	"description": "Match new contributors to the Make WordPress teams that fit their interests and skills.",
	"textdomain": "wporg",
	"supports": {
		"align": true,
		"html": false,
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true
		},
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true
		},
		"multiple": false
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css"
}
